@model FashionShop.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="container mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-8">Thông Tin Thanh Toán</h1>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
            <div class="bg-white rounded-lg shadow-md overflow-hidden mb-6">
                <div class="border-b px-6 py-4">
                    <h2 class="text-lg font-medium">Địa Chỉ</h2>
                </div>
                <div class="px-6 py-4">
                    <form asp-controller="Cart" asp-action="PlaceOrder" method="post" id="checkout-form">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                            <div>
                                <label for="firstName" class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                                <input type="text" id="firstName" name="User.FirstName" value="@Model.User.first_name" required class="w-full px-4 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                            </div>
                            <div>
                                <label for="lastName" class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                                <input type="text" id="lastName" name="User.LastName" value="@Model.User.last_name" required class="w-full px-4 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                            </div>
                        </div>

                        <div class="mb-6">
                            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                            <input type="email" id="email" name="User.Email" value="@Model.User.email" required class="w-full px-4 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                        </div>

                        <div class="mb-6">
                            <label for="phoneNumber" class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                            <input type="text" id="phoneNumber" name="PhoneNumber" value="@Model.User.phone_number" required class="w-full px-4 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                        </div>

                        <div class="mb-6">
                            <label for="shippingAddress" class="block text-sm font-medium text-gray-700 mb-1">Shipping Address</label>
                            <textarea id="shippingAddress" name="ShippingAddress" required class="w-full px-4 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-indigo-500" rows="3">@Model.ShippingAddress</textarea>
                        </div>

                        <div class="border-t pt-6 mt-6">
                            <h3 class="text-lg font-medium mb-4">Phương Thức Thanh Toán</h3>
                            <div class="space-y-4">
                                @foreach (var payment in Model.PaymentMethods)
                                {
                                    <div class="flex items-center">
                                        <input type="radio" id="payment-@payment.payment_id" name="SelectedPaymentId" value="@payment.payment_id" required class="h-4 w-4 text-indigo-600 focus:ring-indigo-500" @(payment.payment_id == 1 ? "checked" : "") />
                                        <label for="payment-@payment.payment_id" class="ml-3 block text-sm font-medium text-gray-700">
                                            @payment.name
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="mt-8">
                            <button type="submit" class="w-full bg-indigo-600 text-white px-6 py-3 rounded-md hover:bg-indigo-700">
                                Thanh Toán
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>