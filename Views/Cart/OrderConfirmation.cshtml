@model Order
@{
    ViewData["Title"] = "Xác Nhận Đơn Hàng";
}

<div class="container mx-auto px-4 py-10">
    <div class="max-w-3xl mx-auto bg-white rounded-lg shadow-md overflow-hidden">
        <div class="bg-indigo-600 px-6 py-8 text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-white text-indigo-600 rounded-full mb-4">
                <i class="fas fa-check text-2xl"></i>
            </div>
            <h1 class="text-3xl font-bold text-white mb-2">Đơn Hàng Đã Xác Nhận!</h1>
            <p class="text-indigo-100">Cảm ơn bạn đã mua hàng</p>
        </div>

        <div class="px-6 py-6">
            <div class="border-b pb-4 mb-4">
                <h2 class="text-xl font-bold mb-4">Chi Tiết Đơn Hàng</h2>
                <div class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                        <p class="text-gray-600">Mã Đơn Hàng:</p>
                        <p class="font-medium">#@Model.order_id </p>
                    </div>
                    <div>
                        <p class="text-gray-600">Ngày:</p>
                        <p class="font-medium">@Model.order_date.ToString("MMMM dd, yyyy")</p>
                    </div>
                    <div>
                        <p class="text-gray-600">Tổng Tiền:</p>
                        <p class="font-medium">@(Model.total_price.HasValue ? Model.total_price.Value.ToString("N0") : "0")</p>
                    </div>
                    <div>
                        <p class="text-gray-600">Phương Thức Thanh Toán:</p>
                        <p class="font-medium">@Model.Payment.name</p>
                    </div>
                </div>
            </div>

            <div class="mb-6">
                <h3 class="text-lg font-medium mb-4">Các Sản Phẩm Đã Đặt</h3>
                <div class="space-y-4">
                    @foreach (var item in Model.Order_item)
                    {
                        <div class="flex items-center">
                            <div class="flex-shrink-0 w-16 h-16">
                                <img src="~/Images/ProductImage/@item.Color.image_url" alt="@item.Product.name" class="w-full h-full object-cover rounded" />
                            </div>
                            <div class="ml-4 flex-1">
                                <h4 class="text-sm font-medium">@item.Product.name</h4>
                                <p class="text-xs text-gray-500">Màu: @item.Color.color_name, Số lượng: @item.quantity</p>
                            </div>
                            <div class="text-right">
                                <p class="text-sm font-medium">@((item.price * item.quantity).ToString("N0"))</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="border-t pt-6">
                <div class="flex justify-between mb-2">
                    <span class="text-gray-600">Tạm tính:</span>
                    <span>@(Model.total_price.HasValue ? Model.total_price.Value.ToString("N0") : "0")</span>
                </div>
                <div class="flex justify-between mb-2">
                    <span class="text-gray-600">Phí vận chuyển:</span>
                    <span>Miễn phí</span>
                </div>
                <div class="flex justify-between font-bold text-lg mt-4">
                    <span>Tổng cộng:</span>
                    <span>@(Model.total_price.HasValue ? Model.total_price.Value.ToString("N0") : "0")</span>
                </div>
            </div>
        </div>

        <div class="bg-gray-50 px-6 py-4 flex justify-between items-center">
            <div>
                <p class="text-gray-600 text-sm">Có thắc mắc về đơn hàng của bạn?</p>
                <a href="#" class="text-indigo-600 text-sm hover:underline">Liên Hệ Hỗ Trợ</a>
            </div>
            <div class="flex space-x-3">
                <a asp-controller="Account" asp-action="Orders" class="text-indigo-600 border border-indigo-600 px-4 py-2 rounded hover:bg-indigo-50">
                    Xem Đơn Hàng
                </a>
                <a asp-controller="Home" asp-action="Index" class="bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700">
                    Tiếp Tục Mua Sắm
                </a>
            </div>
        </div>
    </div>
</div>