@model FashionShop.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-8">Giỏ Hàng</h1>

    @if (Model.CartItems.Count == 0)
    {
        <div class="bg-white rounded-lg shadow-md p-8 mb-8 text-center">
            <div class="mb-6">
                <i class="fas fa-shopping-cart text-gray-300 text-6xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-700 mb-4">Giỏ hàng trống</h2>
            <p class="text-gray-500 mb-6">Looks like you haven't added any items to your cart yet.</p>
            <a asp-controller="Product" asp-action="Index" class="bg-indigo-600 text-white px-6 py-3 rounded-md hover:bg-indigo-700 inline-block">
                Mua Sắm
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                    <div class="border-b px-6 py-4 flex justify-between items-center">
                        <h2 class="text-lg font-medium">Đơn Hàng (@Model.ItemCount)</h2>
                    </div>

                    <div>
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="border-b last:border-b-0 px-6 py-4 flex flex-col sm:flex-row">
                                <div class="flex-shrink-0 w-full sm:w-24 h-24 mb-4 sm:mb-0">
                                    <img src="~/Images/ProductImage/@item.Color.image_url" alt="@item.Product.name" class="w-full h-full object-cover rounded" />
                                </div>
                                <div class="sm:ml-6 flex-1 flex flex-col justify-between">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <h3 class="text-base font-medium text-gray-800">
                                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Product.product_id" class="hover:text-indigo-600">
                                                    @item.Product.name
                                                </a>
                                            </h3>
                                            <div class="mt-1 text-sm text-gray-500 flex flex-wrap">
                                                <div class="mr-4">
                                                    <span>Màu: </span>
                                                    <span class="inline-block w-3 h-3 rounded-full align-middle" style="background-color: @item.Color.color_hex"></span>
                                                    <span class="ml-1">@item.Color.color_name</span>
                                                </div>
                                                <div>
                                                    <span>Size: </span>
                                                    @{
                                                        string sizeName = "";
                                                        switch (item.size)
                                                        {
                                                            case 0:
                                                                sizeName = "S";
                                                                break;
                                                            case 1:
                                                                sizeName = "M";
                                                                break;
                                                            case 2:
                                                                sizeName = "L";
                                                                break;
                                                            case 3:
                                                                sizeName = "XL";
                                                                break;
                                                            case 4:
                                                                sizeName = "XXL";
                                                                break;
                                                            default:
                                                                sizeName = item.size.ToString();
                                                                break;
                                                        }
                                                    }
                                                    <span class="font-medium">@sizeName</span>
                                                </div>
                                            </div>
                                            <p class="mt-1 text-sm text-gray-500">Giá: @item.Product.price.ToString("N0") đ</p>
                                        </div>
                                        <div class="text-right">
                                            <p class="text-base font-medium text-indigo-600">@((item.Product.price * item.quantity).ToString("N0")) đ</p>
                                        </div>
                                    </div>
                                    <div class="flex justify-between items-center mt-4">
                                        <div class="flex items-center">
                                            <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="flex">
                                                <input type="hidden" name="cartItemId" value="@item.cart_item_id" />
                                                <div class="flex items-center">
                                                    <button type="submit" name="quantity" value="@(item.quantity - 1)" class="border rounded-l px-2 py-1 hover:bg-gray-100 @(item.quantity <= 1 ? "opacity-50 cursor-not-allowed" : "")" @(item.quantity <= 1 ? "disabled" : "")>
                                                        -
                                                    </button>
                                                    <span class="border-t border-b px-4 py-1">@item.quantity</span>
                                                    <button type="submit" name="quantity" value="@(item.quantity + 1)" class="border rounded-r px-2 py-1 hover:bg-gray-100">
                                                        +
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                        <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                            <input type="hidden" name="cartItemId" value="@item.cart_item_id" />
                                            <button type="submit" class="text-red-500 hover:text-red-700">
                                                <i class="fas fa-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div>
                <div class="bg-white rounded-lg shadow-md overflow-hidden">
                    <div class="border-b px-6 py-4">
                        <h2 class="text-lg font-medium">Thông Tin Đơn Hàng</h2>
                    </div>
                    <div class="px-6 py-4">
                        <div class="flex justify-between items-center mb-4">
                            <span class="text-gray-600">Giá</span>
                            <span class="font-medium">@Model.TotalPrice.ToString("N0") đ</span>
                        </div>
                        <div class="flex justify-between items-center mb-4">
                            <span class="text-gray-600">Vận Chuyển</span>
                            <span class="font-medium">Free</span>
                        </div>
                        <div class="border-t pt-4 mt-4">
                            <div class="flex justify-between items-center mb-6">
                                <span class="text-lg font-medium">Tổng Tiền </span>
                                <span class="text-xl font-bold text-indigo-600">@Model.TotalPrice.ToString("N0") đ</span>
                            </div>
                            <a asp-controller="Cart" asp-action="Checkout" class="block bg-indigo-600 text-white text-center px-6 py-3 rounded-md hover:bg-indigo-700">
                                Tiếp Tục Thanh Toán
                            </a>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-lg shadow-md overflow-hidden mt-6">
                    <div class="border-b px-6 py-4">
                        <h2 class="text-lg font-medium">Mã Giảm Giá</h2>
                    </div>
                    <div class="px-6 py-4">
                        <form class="flex">
                            <input type="text" placeholder="Nhập mã giảm giá" class="flex-1 px-4 py-2 border rounded-l focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                            <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded-r hover:bg-indigo-700">
                                Áp dụng
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>