<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["title"] - FashionShop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/output.css" />
</head>
<body>
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="container mx-auto px-4">
            <div class="flex justify-between items-center py-4">
                <a asp-controller="Home" asp-action="Index" class="text-2xl font-bold text-indigo-600">Fashion<span class="text-gray-800">Shop</span></a>

                <div class="hidden md:flex space-x-8">
                    <a asp-controller="Home" asp-action="Index" class="text-gray-600 hover:text-indigo-600">Trang Chủ</a>
                    <div class="relative group">
                        <a href="#" class="text-gray-600 hover:text-indigo-600">Thể Loại</a>
                        <div class="absolute left-0 mt-2 w-48 bg-white rounded-md shadow-lg z-10 hidden group-hover:block">
                            @await Component.InvokeAsync("CategoryMenu")
                        </div>
                    </div>
                    <a asp-controller="Product" asp-action="Index" class="text-gray-600 hover:text-indigo-600">Shop</a>
                    <a asp-controller="Blog" asp-action="Index" class="text-gray-600 hover:text-indigo-600">Blog</a>
                    <a asp-controller="Home" asp-action="Contact" class="text-gray-600 hover:text-indigo-600">Liên Hệ</a>
                </div>

                <div class="flex items-center space-x-4">
                    <form asp-controller="Product" asp-action="Index" method="get" class="hidden md:block">
                        <div class="relative">
                            <input type="text" name="search" placeholder="Search..." class="bg-gray-100 rounded-full py-2 px-4 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-64" />
                            <button type="submit" class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-500">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>

                    <div class="flex space-x-3">
                        @if (Context.Session.GetInt32("user_id") != null)
                        {
                            <a asp-controller="Wishlist" asp-action="Index" class="text-gray-600 hover:text-indigo-600">
                                <i class="fas fa-heart"></i>
                            </a>
                            <a asp-controller="Cart" asp-action="Index" class="text-gray-600 hover:text-indigo-600 relative">
                                <i class="fas fa-shopping-cart"></i>
                                @await Component.InvokeAsync("CartSummary")
                            </a>
                            <div class="relative group">
                                <a href="#" class="text-gray-600 group-hover:text-indigo-600">
                                    <i class="fas fa-user"></i>
                                </a>
                                <!-- Menu dropdown -->
                                <div class="absolute right-0 w-48 bg-white rounded-md shadow-lg z-10 hidden group-hover:block">
                                    <div class="py-1">
                                        <span class="block px-4 py-2 text-sm text-gray-700 border-b">
                                            Hello, @Context.Session.GetString("username")
                                        </span>
                                        <a asp-controller="Account" asp-action="Profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Profile</a>
                                        <a asp-controller="Account" asp-action="Orders" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Orders</a>
                                        <a asp-controller="Account" asp-action="Logout" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Logout</a>
                                    </div>
                                </div>
                            </div>

                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="text-indigo-600 hover:text-indigo-800">Login</a>
                            <a asp-controller="Account" asp-action="Register" class="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700">Register</a>
                        }
                    </div>

                    <button class="md:hidden text-gray-600" id="menu-toggle">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile menu -->
            <div class="md:hidden hidden" id="mobile-menu">
                <div class="px-2 pt-2 pb-3 space-y-1">
                    <a asp-controller="Home" asp-action="Index" class="block px-3 py-2 text-gray-600 hover:text-indigo-600">Home</a>
                    <a asp-controller="Product" asp-action="Index" class="block px-3 py-2 text-gray-600 hover:text-indigo-600">Shop</a>
                    <a asp-controller="Blog" asp-action="Index" class="block px-3 py-2 text-gray-600 hover:text-indigo-600">Blog</a>
                    <a asp-controller="Home" asp-action="Contact" class="block px-3 py-2 text-gray-600 hover:text-indigo-600">Contact</a>
                    <form asp-controller="Product" asp-action="Index" method="get" class="mt-3">
                        <input type="text" name="search" placeholder="Search..." class="bg-gray-100 rounded-full py-2 px-4 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full" />
                    </form>
                </div>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-gray-900 text-white py-12">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div>
                    <h3 class="text-xl font-bold mb-4">Fashion<span class="text-indigo-400">Shop</span></h3>
                    <p class="text-gray-400 mb-4">
                        Your ultimate destination for trendy and fashionable clothing. We offer high-quality products at affordable prices.
                    </p>
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-400 hover:text-white"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="text-gray-400 hover:text-white"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-gray-400 hover:text-white"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="text-gray-400 hover:text-white"><i class="fab fa-pinterest"></i></a>
                    </div>
                </div>

                <div>
                    <h3 class="text-lg font-semibold mb-4">Quick Links</h3>
                    <ul class="space-y-2 text-gray-400">
                        <li><a href="#" class="hover:text-white">Home</a></li>
                        <li><a href="#" class="hover:text-white">Shop</a></li>
                        <li><a href="#" class="hover:text-white">About Us</a></li>
                        <li><a href="#" class="hover:text-white">Contact</a></li>
                        <li><a href="#" class="hover:text-white">Blog</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-lg font-semibold mb-4">Customer Service</h3>
                    <ul class="space-y-2 text-gray-400">
                        <li><a href="#" class="hover:text-white">My Account</a></li>
                        <li><a href="#" class="hover:text-white">Order Tracking</a></li>
                        <li><a href="#" class="hover:text-white">Wishlist</a></li>
                        <li><a href="#" class="hover:text-white">Terms & Conditions</a></li>
                        <li><a href="#" class="hover:text-white">Privacy Policy</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="text-lg font-semibold mb-4">Newsletter</h3>
                    <p class="text-gray-400 mb-4">
                        Subscribe to our newsletter to get updates about our products and offers.
                    </p>
                    <form class="flex">
                        <input type="email" placeholder="Your email" class="px-4 py-2 w-full focus:outline-none" />
                        <button type="submit" class="bg-indigo-600 text-white px-4 py-2 hover:bg-indigo-700">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </div>

            <div class="border-t border-gray-800 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center">
                <p class="text-gray-400">
                    &copy; 2025 FashionShop. All rights reserved.
                </p>
                <div class="mt-4 md:mt-0">
                    <img src="~/images/payment-methods.png" alt="Payment Methods" class="h-8" />
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.getElementById('menu-toggle').addEventListener('click', function () {
            const mobileMenu = document.getElementById('mobile-menu');
            mobileMenu.classList.toggle('hidden');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_ChatWidget")
</body>
</html>