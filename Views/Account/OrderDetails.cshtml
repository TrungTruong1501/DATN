@model Order
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
}

<div class="container mx-auto px-4 py-10">
    <div class="flex items-center mb-8">
        <a asp-controller="Account" asp-action="Orders" class="text-indigo-600 hover:text-indigo-800 mr-2">
            <i class="fas fa-arrow-left"></i> Quay lại Đơn Hàng
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
            <div class="bg-white rounded-lg shadow-md overflow-hidden mb-6">
                <div class="border-b px-6 py-4">
                    <h2 class="text-lg font-medium">Sản Phẩm Đã Đặt</h2>
                </div>
                <div class="px-6 py-4">
                    <div class="space-y-4">
                        @foreach (var item in Model.Order_item)
                        {
                            <div class="flex items-center">
                                <div class="flex-shrink-0 w-16 h-16">
                                    <img src="~/Images/ProductImage/@item.Color.image_url" alt="@item.Product.name" class="w-full h-full object-cover rounded" />
                                </div>
                                <div class="ml-4 flex-1">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.product_id" class="text-sm font-medium hover:text-indigo-600">
                                        @item.Product.name
                                    </a>
                                    <p class="text-xs text-gray-500">Màu: @item.Color.color_name, Số lượng: @item.quantity</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-sm font-medium">@((item.price * item.quantity).ToString("N0"))</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-md overflow-hidden mb-6">
                <div class="border-b px-6 py-4">
                    <h2 class="text-lg font-medium">Tổng Hợp Đơn Hàng</h2>
                </div>
                <div class="px-6 py-4">
                    <div class="flex justify-between mb-2">
                        <span class="text-gray-600">Tạm tính:</span>
                        <span>@(Model.total_price?.ToString("N0") ?? "0")</span>
                    </div>
                    <div class="flex justify-between mb-2">
                        <span class="text-gray-600">Phí vận chuyển:</span>
                        <span>Miễn phí</span>
                    </div>
                    <div class="flex justify-between font-bold text-lg mt-4">
                        <span>Tổng cộng:</span>
                        <span>@(Model.total_price?.ToString("N0") ?? "0")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg shadow-md overflow-hidden mb-6">
                <div class="border-b px-6 py-4">
                    <h2 class="text-lg font-medium">Thông Tin Đơn Hàng</h2>
                </div>
                <div class="px-6 py-4">
                    <div class="mb-4">
                        <h3 class="text-sm font-medium text-gray-700 mb-1">Mã Đơn Hàng</h3>
                        <p>#@Model.order_id</p>
                    </div>
                    <div class="mb-4">
                        <h3 class="text-sm font-medium text-gray-700 mb-1">Ngày Đặt</h3>
                        <p>@Model.order_date.ToString("MMMM dd, yyyy")</p>
                    </div>
                    <div class="mb-4">
                        <h3 class="text-sm font-medium text-gray-700 mb-1">Trạng Thái</h3>
                        @{
                            string statusClass;
                            string statusText;

                            switch (Model.order_status)
                            {
                                case 0:
                                    statusClass = "bg-yellow-100 text-yellow-800";
                                    statusText = "Chờ xử lý";
                                    break;
                                case 1:
                                    statusClass = "bg-blue-100 text-blue-800";
                                    statusText = "Đang xử lý";
                                    break;
                                case 2:
                                    statusClass = "bg-green-100 text-green-800";
                                    statusText = "Hoàn thành";
                                    break;
                                default:
                                    statusClass = "bg-gray-100 text-gray-800";
                                    statusText = "Không xác định";
                                    break;
                            }
                        }
                        <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full @statusClass">
                            @statusText
                        </span>
                    </div>
                    <div class="mb-4">
                        <h3 class="text-sm font-medium text-gray-700 mb-1">Phương Thức Thanh Toán</h3>
                        <p>@Model.Payment.name</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-md overflow-hidden">
                <div class="border-b px-6 py-4">
                    <h2 class="text-lg font-medium">Thông Tin Giao Hàng</h2>
                </div>
                <div class="px-6 py-4">
                    <div class="mb-4">
                        <h3 class="text-sm font-medium text-gray-700 mb-1">Địa Chỉ</h3>
                        <p>@Model.address</p>
                    </div>
                    <div>
                        <h3 class="text-sm font-medium text-gray-700 mb-1">Số Điện Thoại</h3>
                        <p>@Model.phone</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>