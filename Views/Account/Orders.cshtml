@model List<Order>
@{
    ViewData["Title"] = "Đơn Hàng Của Tôi";
}

<div class="container mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-8">Đơn Hàng Của Tôi</h1>

    @if (Model == null || Model.Count == 0)
    {
        <div class="bg-white rounded-lg shadow-md p-8 mb-8 text-center">
            <div class="mb-6">
                <i class="fas fa-shopping-bag text-gray-300 text-6xl"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-700 mb-4">Chưa có đơn hàng</h2>
            <p class="text-gray-500 mb-6">Có vẻ như bạn chưa đặt bất kỳ đơn hàng nào.</p>
            <a asp-controller="Product" asp-action="Index" class="bg-indigo-600 text-white px-6 py-3 rounded-md hover:bg-indigo-700 inline-block">
                Bắt Đầu Mua Sắm
            </a>
        </div>
    }
    else
    {
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>

                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Ngày Đặt
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Tổng Tiền
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Trạng Thái
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Thanh Toán
                            </th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Thao Tác
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var order in Model)
                        {
                            <tr>

                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@order.order_date.ToString("MMM dd, yyyy")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-indigo-600">@(order.total_price?.ToString("N0") ?? "0")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @{
                                        string statusClass;
                                        string statusText;

                                        switch (order.order_status)
                                        {
                                            case 0:
                                                statusClass = "bg-yellow-100 text-yellow-800";
                                                statusText = "Chờ xử lý";
                                                break;
                                            case 1:
                                                statusClass = "bg-blue-100 text-blue-800";
                                                statusText = "Đang xử lý";
                                                break;
                                            case 2:
                                                statusClass = "bg-green-100 text-green-800";
                                                statusText = "Hoàn thành";
                                                break;
                                            default:
                                                statusClass = "bg-gray-100 text-gray-800";
                                                statusText = "Không xác định";
                                                break;
                                        }
                                    }
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @statusClass">
                                        @statusText
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@order.Payment.name</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <a asp-controller="Account" asp-action="OrderDetails" asp-route-id="@order.order_id" class="text-indigo-600 hover:text-indigo-900">
                                        Xem Chi Tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>