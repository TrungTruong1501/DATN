@model FashionShop.Models.ViewModels.HomeViewModel
@{
    ViewData["title"] = "Trang Chủ";
}

<!-- Hero Section -->
<section class="relative bg-gray-100">
    <div class="container mx-auto px-4 py-16 md:py-24">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <div>
                <h1 class="text-4xl md:text-5xl font-bold mb-4">Tìm Phong Cách Hoàn Hảo Của Bạn</h1>
                <p class="text-gray-600 text-lg mb-8">
                    Khám phá các xu hướng thời trang mới nhất và nhận giảm giá lên đến 50% cho lần mua hàng đầu tiên.
                </p>
                <div class="flex space-x-4">
                    <a asp-controller="Product" asp-action="Index" class="bg-indigo-600 text-white px-6 py-3 rounded-md hover:bg-indigo-700 inline-block">
                        Mua Ngay
                    </a>
                    <a href="#categories" class="border border-indigo-600 text-indigo-600 px-6 py-3 rounded-md hover:bg-indigo-50 inline-block">
                        Xem Danh Mục
                    </a>
                </div>
            </div>
            <div class="relative">
                <img src="~/Images/branch/Banner.jpg" alt="Fashion Hero" class="rounded-lg shadow-lg w-full" />
                <div class="absolute top-0 right-0 bg-indigo-600 text-white py-2 px-4 rounded-bl-lg rounded-tr-lg">
                    HOT SALE
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section id="categories" class="py-16 bg-white">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Mua Sắm Theo Danh Mục</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            @foreach (var category in Model.Categories)
            {
                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.category_id" class="group">
                    <div class="bg-gray-100 rounded-lg overflow-hidden transition-transform transform hover:scale-105">
                        <img src="~/Images/ProductImage/@category.image" alt="@category.name" class="w-full h-48 object-cover" />
                        <div class="p-4 bg-white">
                            <h3 class="font-medium text-center text-gray-800 group-hover:text-indigo-600">@category.name</h3>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<!-- Featured Products Section -->
<section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Sản Phẩm Nổi Bật</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="bg-white rounded-lg shadow-md overflow-hidden group">
                    <div class="relative overflow-hidden">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.product_id">
                            <img src="~/Images/ProductImage/@product.image" alt="@product.name" class="w-full h-64 object-cover transform transition-transform group-hover:scale-105" />
                        </a>
                        <div class="absolute inset-0 bg-black bg-opacity-20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center space-x-2">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.product_id" class="bg-white p-2 rounded-full hover:bg-indigo-600 hover:text-white">
                                <i class="fas fa-eye"></i>
                            </a>
                            @if (Context.Session.GetInt32("user_id") != null)
                            {
                                <form asp-controller="Wishlist" asp-action="AddToWishlist" method="post">
                                    <input type="hidden" name="productId" value="@product.product_id" />
                                    <button type="submit" class="bg-white p-2 rounded-full hover:bg-indigo-600 hover:text-white">
                                        <i class="fas fa-heart"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                    <div class="p-4">
                        <h3 class="font-medium text-gray-800 mb-2 truncate">@product.name</h3>
                        <div class="flex justify-between items-center">
                            <p class="text-indigo-600 font-bold">@product.price.ToString("N0")</p>
                            <div class="flex space-x-1">
                                @if (product.Colors != null && product.Colors.Count > 0)
                                {
                                    @foreach (var color in product.Colors.Take(3))
                                    {
                                        <div class="w-4 h-4 rounded-full border border-gray-300" style="background-color: @color.color_hex"></div>
                                    }
                                    @if (product.Colors.Count > 3)
                                    {
                                        <div class="text-gray-500 text-xs">+@(product.Colors.Count - 3)</div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-10">
            <a asp-controller="Product" asp-action="Index" class="bg-indigo-600 text-white px-6 py-3 rounded-md hover:bg-indigo-700 inline-block">
                Xem Tất Cả Sản Phẩm
            </a>
        </div>
    </div>
</section>

<!-- New Arrivals Section -->
<section class="py-16 bg-white">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Sản Phẩm Mới</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var product in Model.NewArrivals)
            {
                <div class="bg-white rounded-lg border border-gray-200 overflow-hidden group">
                    <div class="relative overflow-hidden">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.product_id">
                            <img src="~/Images/ProductImage/@product.image" alt="@product.name" class="w-full h-64 object-cover transform transition-transform group-hover:scale-105" />
                        </a>
                        <div class="absolute top-0 left-0 bg-indigo-600 text-white py-1 px-3 text-xs">MỚI</div>
                    </div>
                    <div class="p-4">
                        <h3 class="font-medium text-gray-800 mb-2 truncate">@product.name</h3>
                        <p class="text-indigo-600 font-bold">@product.price.ToString("N0")</p>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.product_id" class="mt-3 text-indigo-600 hover:text-indigo-800 inline-block">
                            Xem Chi Tiết <i class="fas fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Blog Section -->
<section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Bài Viết Mới Nhất</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            @foreach (var blog in Model.RecentBlogs)
            {
                <div class="bg-white rounded-lg overflow-hidden shadow-md">
                    <img src="~/Images/Blog/@blog.thumbnail" alt="@blog.title" class="w-full h-56 object-cover" />
                    <div class="p-6">
                        <div class="flex items-center text-gray-500 text-sm mb-2">
                            <i class="far fa-calendar-alt mr-2"></i> @blog.date
                            <span class="mx-2">|</span>
                            <i class="far fa-user mr-2"></i> @blog.author
                        </div>
                        <h3 class="font-bold text-xl mb-2 truncate">@blog.title</h3>
                        <p class="text-gray-600 mb-4 line-clamp-2">@blog.contentBlog</p>
                        <a asp-controller="Blog" asp-action="Details" asp-route-id="@blog.id" class="text-indigo-600 hover:text-indigo-800 font-medium">
                            Đọc Thêm <i class="fas fa-long-arrow-alt-right ml-1"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-10">
            <a asp-controller="Blog" asp-action="Index" class="bg-indigo-600 text-white px-6 py-3 rounded-md hover:bg-indigo-700 inline-block">
                Xem Tất Cả Bài Viết
            </a>
        </div>
    </div>
</section>

<!-- Newsletter Section -->
<section class="py-16 bg-indigo-600">
    <div class="container mx-auto px-4">
        <div class="text-center text-white">
            <h2 class="text-3xl font-bold mb-4">Đăng Ký Nhận Bản Tin</h2>
            <p class="text-indigo-100 mb-8 max-w-2xl mx-auto">
                Nhận các cập nhật mới nhất, khuyến mãi và ưu đãi trực tiếp vào hộp thư của bạn. Luôn cập nhật xu hướng thời trang với FashionShop.
            </p>
            <form class="max-w-md mx-auto flex">
                <input type="email" placeholder="Địa chỉ email của bạn" class="px-4 py-3 w-full rounded-l-md focus:outline-none" />
                <button type="submit" class="bg-indigo-800 text-white px-6 py-3 rounded-r-md hover:bg-indigo-900">
                    Đăng Ký
                </button>
            </form>
        </div>
    </div>
</section>