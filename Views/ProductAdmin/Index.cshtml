@model List<Product>
@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var currentPage = ViewBag.CurrentPage;
    var totalPages = ViewBag.TotalPages;
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="pb-5 border-b border-gray-200 mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Sản Phẩm</h3>

        <div class="mt-3 sm:mt-0 flex flex-col sm:flex-row sm:space-x-4">
            <!-- Form tìm kiếm -->
            <form asp-action="Index" method="get" class="flex flex-1 min-w-0 mb-2 sm:mb-0">
                <div class="relative rounded-md shadow-sm flex-grow mr-2">
                    <input type="text" name="searchTerm" value="@searchTerm" class="focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" placeholder="Tìm kiếm theo tên, mô tả..." />
                    <input type="hidden" name="page" value="1" />
                </div>
                <button type="submit" class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <i class="fas fa-search mr-2"></i> Tìm
                </button>
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <a href="@Url.Action("Index", "ProductAdmin")" class="ml-2 inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        <i class="fas fa-times mr-2"></i> Xóa bộ lọc
                    </a>
                }
            </form>

            <!-- Nút thêm sản phẩm -->
            <a href="@Url.Action("Add", "ProductAdmin")" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                <i class="fas fa-plus -ml-1 mr-2"></i>
                Thêm Sản Phẩm
            </a>
        </div>
    </div>
</div>

<!-- Hiển thị thông báo kết quả tìm kiếm -->
@if (!string.IsNullOrEmpty(searchTerm))
{
    <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <i class="fas fa-info-circle text-blue-400"></i>
            </div>
            <div class="ml-3">
                <p class="text-sm text-blue-700">
                    Kết quả tìm kiếm cho: <strong>@searchTerm</strong>
                </p>
            </div>
        </div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-green-100 border-l-4 border-green-400 p-4 mb-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <i class="fas fa-check-circle text-green-400"></i>
            </div>
            <div class="ml-3">
                <p class="text-sm text-green-700">
                    @TempData["SuccessMessage"]
                </p>
            </div>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="bg-red-100 border-l-4 border-red-400 p-4 mb-4">
        <div class="flex">
            <div class="flex-shrink-0">
                <i class="fas fa-exclamation-circle text-red-400"></i>
            </div>
            <div class="ml-3">
                <p class="text-sm text-red-700">
                    @TempData["ErrorMessage"]
                </p>
            </div>
        </div>
    </div>
}

<div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Hình Ảnh</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tên</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Danh Mục</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Giá</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tồn Kho</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Thao Tác</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="px-6 py-4 text-center text-sm text-gray-500">
                            <div class="flex flex-col items-center justify-center py-4">
                                <i class="fas fa-search text-gray-400 text-3xl mb-3"></i>
                                <p>Không tìm thấy sản phẩm nào</p>
                                @if (!string.IsNullOrEmpty(searchTerm))
                                {
                                    <p class="mt-1">Thử tìm kiếm với từ khóa khác hoặc <a href="@Url.Action("Index", "ProductAdmin")" class="text-indigo-600 hover:text-indigo-900">xem tất cả sản phẩm</a>.</p>
                                }
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@product.product_id</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <img src="~/Images/ProductImage/@product.image" alt="@product.name" class="h-10 w-10 rounded-full object-cover" />
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 max-w-xs truncate">@product.name</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@product.Category.name</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@product.price.ToString("N0")</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@product.stock</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <a href="@Url.Action("Edit", "ProductAdmin", new { id = product.product_id })" class="text-indigo-600 hover:text-indigo-900 mr-3">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="text-red-600 hover:text-red-900" onclick="confirmDelete(@product.product_id, '@product.name')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Phân Trang -->
@if (totalPages > 1)
{
    <div class="flex justify-center mt-6">
        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Phân trang">
            @if (currentPage > 1)
            {
                <a href="@Url.Action("Index", "ProductAdmin", new { page = currentPage - 1, searchTerm })" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                    <span class="sr-only">Trước</span>
                    <i class="fas fa-chevron-left h-5 w-5"></i>
                </a>
            }

            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                <a href="@Url.Action("Index", "ProductAdmin", new { page = i, searchTerm })" class="relative inline-flex items-center px-4 py-2 border border-gray-300 @(i == currentPage ? "bg-indigo-50 text-indigo-600" : "bg-white text-gray-500 hover:bg-gray-50") text-sm font-medium">
                    @i
                </a>
            }

            @if (currentPage < totalPages)
            {
                <a href="@Url.Action("Index", "ProductAdmin", new { page = currentPage + 1, searchTerm })" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                    <span class="sr-only">Tiếp</span>
                    <i class="fas fa-chevron-right h-5 w-5"></i>
                </a>
            }
        </nav>
    </div>
}

<!-- Cửa Sổ Xác Nhận Xóa -->
<div id="deleteModal" class="fixed z-10 inset-0 overflow-y-auto hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                <div class="sm:flex sm:items-start">
                    <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                        <i class="fas fa-exclamation-triangle text-red-600"></i>
                    </div>
                    <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                        <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">Xóa Sản Phẩm</h3>
                        <div class="mt-2">
                            <p class="text-sm text-gray-500">Bạn có chắc chắn muốn xóa sản phẩm này? Hành động này không thể hoàn tác.</p>
                            <p class="text-sm font-medium text-gray-900 mt-2" id="productToDelete"></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                <form id="deleteForm" asp-controller="ProductAdmin" asp-action="Delete" method="post">
                    <input type="hidden" id="productId" name="id" value="" />
                    <button type="submit" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm">
                        Xóa
                    </button>
                </form>
                <button type="button" onclick="closeModal()" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
                    Hủy
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('productId').value = id;
            document.getElementById('productToDelete').textContent = name;
            document.getElementById('deleteModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('deleteModal').classList.add('hidden');
        }
    </script>
}