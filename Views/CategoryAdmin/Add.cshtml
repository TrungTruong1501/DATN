@model Category
@{
    ViewData["Title"] = "Thêm Danh Mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="pb-5 border-b border-gray-200 mb-6">
    <h3 class="text-lg leading-6 font-medium text-gray-900">Thêm Danh Mục Mới</h3>
    <p class="mt-2 max-w-4xl text-sm text-gray-500">Tạo một danh mục sản phẩm mới cho cửa hàng của bạn.</p>
</div>
<div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <form asp-controller="CategoryAdmin" asp-action="Add" method="post" enctype="multipart/form-data">
        <div class="px-4 py-5 sm:p-6">
            <div class="grid grid-cols-1 gap-6">
                <div>
                    <label for="name" class="block text-sm font-medium text-gray-700">Tên Danh Mục</label>
                    <input type="text" asp-for="name" id="name" class="mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" required>
                    <span asp-validation-for="name" class="text-sm text-red-600"></span>
                </div>
                <div>
                    <label for="imageFile" class="block text-sm font-medium text-gray-700">Hình Ảnh Danh Mục</label>
                    <div class="mt-1 flex items-center">
                        <span class="inline-block h-12 w-12 rounded-full overflow-hidden bg-gray-100">
                            <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                            </svg>
                        </span>
                        <input type="file" id="imageFile" name="imageFile" class="ml-5 py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm text-sm leading-4 font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    </div>
                    <p class="mt-2 text-sm text-gray-500">Tải lên hình ảnh danh mục. Kích thước khuyến nghị: 300x300px.</p>
                </div>
            </div>
        </div>
        <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
            <a href="@Url.Action("Index", "CategoryAdmin")" class="inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 mr-2">
                Hủy
            </a>
            <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                Lưu
            </button>
        </div>
    </form>
</div>