@model Category
@{
    ViewData["Title"] = "Thêm Danh Mục";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="pb-5 border-b border-gray-200 mb-6">
        <h3 class="text-xl leading-6 font-bold text-gray-900">Thêm Danh Mục Mới</h3>
        <p class="mt-2 max-w-4xl text-sm text-gray-500">Tạo một danh mục sản phẩm mới cho cửa hàng của bạn.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <strong class="font-bold">Thành công!</strong>
            <span class="block sm:inline">@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <strong class="font-bold">Lỗi!</strong>
            <ul class="mt-2 list-disc pl-5">
                @foreach (var modelState in ViewContext.ViewData.ModelState.Values)
                {
                    foreach (var error in modelState.Errors)
                    {
                        <li>@error.ErrorMessage</li>
                    }
                }
            </ul>
        </div>
    }

    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
        <form asp-controller="CategoryAdmin" asp-action="Add" method="post" enctype="multipart/form-data" class="space-y-6">
            <div class="px-4 py-5 sm:p-6">
                <div class="grid grid-cols-1 gap-6">
                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-700">Tên Danh Mục <span class="text-red-500">*</span></label>
                        <input type="text" asp-for="name" id="name" class="mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md" placeholder="Nhập tên danh mục" required>
                        <span asp-validation-for="name" class="text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label for="imageFile" class="block text-sm font-medium text-gray-700">Hình Ảnh Danh Mục <span class="text-red-500">*</span></label>
                        <div class="mt-1 flex items-center space-x-5">
                            <div class="flex-shrink-0 h-20 w-20 rounded-md overflow-hidden bg-gray-100 border border-gray-200">
                                <img id="preview-image" src="#" alt="Preview" class="h-full w-full object-cover hidden">
                                <svg class="h-full w-full text-gray-300" id="placeholder-icon" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                            </div>
                            <div class="flex flex-col">
                                <label for="imageFile" class="cursor-pointer py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 inline-flex items-center">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                    Chọn Hình Ảnh
                                </label>
                                <input type="file" id="imageFile" name="imageFile" class="hidden" accept="image/*" required>
                                <p class="mt-2 text-xs text-gray-500">Tải lên hình ảnh danh mục. Kích thước khuyến nghị: 300x300px.</p>
                                <span asp-validation-for="image" class="text-sm text-red-600 mt-1"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-4 py-3 bg-gray-50 text-right sm:px-6 flex items-center justify-end space-x-3">
                <a href="@Url.Action("Index", "CategoryAdmin")" class="inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    Hủy
                </a>
                <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    Lưu
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function () {
            // Image preview functionality
            $('#imageFile').change(function () {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        $('#preview-image').attr('src', e.target.result).removeClass('hidden');
                        $('#placeholder-icon').addClass('hidden');
                    }
                    reader.readAsDataURL(file);

                    // Validate image size and type
                    const fileSize = file.size / 1024 / 1024; // in MB
                    if (fileSize > 5) {
                        $('span[data-valmsg-for="image"]').text('Kích thước file không được vượt quá 5MB');
                        $('#imageFile').val(''); // Clear the file input
                        $('#preview-image').addClass('hidden');
                        $('#placeholder-icon').removeClass('hidden');
                        return;
                    }

                    const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
                    if (!validTypes.includes(file.type)) {
                        $('span[data-valmsg-for="image"]').text('Chỉ chấp nhận file hình ảnh (JPEG, PNG, GIF, WEBP)');
                        $('#imageFile').val(''); // Clear the file input
                        $('#preview-image').addClass('hidden');
                        $('#placeholder-icon').removeClass('hidden');
                        return;
                    }

                    $('span[data-valmsg-for="image"]').text(''); // Clear any error message
                } else {
                    $('#preview-image').addClass('hidden');
                    $('#placeholder-icon').removeClass('hidden');
                }
            });
        });
    </script>
}