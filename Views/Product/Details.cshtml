@model FashionShop.Models.ViewModels.ProductViewModel
@{
    ViewData["Title"] = Model.Product.name;
    var product = Model.Product;
    var colors = Model.AvailableColors;
    var relatedProducts = Model.RelatedProducts;
}

<div class="container mx-auto px-4 py-10">
    <!-- Breadcrumb -->
    <div class="flex items-center text-sm text-gray-500 mb-6">
        <a asp-controller="Home" asp-action="Index" class="hover:text-indigo-600">Trang Chủ</a>
        <span class="mx-2">/</span>
        <a asp-controller="Product" asp-action="Index" class="hover:text-indigo-600">Cửa Hàng</a>
        <span class="mx-2">/</span>
        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@product.category_id" class="hover:text-indigo-600">@product.Category.name</a>
        <span class="mx-2">/</span>
        <span class="text-gray-700">@product.name</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-10">
        <!-- Product Images -->
        <div>
            <div class="w-full overflow-hidden rounded-lg mb-4">
                <img id="main-image" src="~/Images/ProductImage/@product.image" alt="@product.name" class="w-full h-[500px] object-cover" />
            </div>

            @if (!string.IsNullOrEmpty(product.gallery))
            {
                <div class="grid grid-cols-4 gap-2">
                    @foreach (var image in product.gallery.Split(','))
                    {
                        <div class="cursor-pointer rounded-md overflow-hidden hover:opacity-75 transition-opacity">
                            <img src="~/Images/ProductImage/@image" alt="" class="thumbnail w-full h-24 object-cover" />
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Product Details -->
        <div>
            <h1 class="text-3xl font-bold text-gray-800 mb-2">@product.name</h1>
            <p class="text-2xl text-indigo-600 font-bold mb-4">@product.price.ToString("N0")</p>

            <div class="mb-6">
                <p class="text-gray-600">@product.description</p>
            </div>

            <div class="mb-6">
                <h3 class="text-sm font-medium text-gray-700 mb-2">Tình trạng:</h3>
                @if (product.stock > 0)
                {
                    <span class="text-green-600 font-medium">Còn Hàng (@product.stock sản phẩm)</span>
                }
                else
                {
                    <span class="text-red-600 font-medium">Hết Hàng</span>
                }
            </div>

            @if (colors.Count > 0)
            {
                <div class="mb-6">
                    <h3 class="text-sm font-medium text-gray-700 mb-2">Màu sắc:</h3>
                    <div id="color-options" class="flex space-x-2">
                        @foreach (var color in colors)
                        {
                            <div data-color-id="@color.color_id" data-image="@color.image_url" class="color-option w-8 h-8 rounded-full border-2 border-transparent cursor-pointer" style="background-color: @color.color_hex" title="@color.color_name"></div>
                        }
                    </div>
                    <input type="hidden" id="selected-color-id" value="@colors.FirstOrDefault().color_id" />
                </div>
            }

            <div class="mb-6">
                <h3 class="text-sm font-medium text-gray-700 mb-2">Số lượng:</h3>
                <div class="flex items-center">
                    <button id="decrease-quantity" class="border rounded-l px-3 py-1 hover:bg-gray-100">-</button>
                    <input type="number" id="quantity" class="border-t border-b w-16 text-center py-1" value="1" min="1" max="@product.stock" />
                    <button id="increase-quantity" class="border rounded-r px-3 py-1 hover:bg-gray-100">+</button>
                </div>
            </div>

            <div class="flex space-x-4 mb-6">
                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex-grow">
                    <input type="hidden" name="productId" value="@product.product_id" />
                    <input type="hidden" name="colorId" id="form-color-id" value="@colors.FirstOrDefault().color_id" />
                    <input type="hidden" name="quantity" id="form-quantity" value="1" />
                    <button type="submit" class="w-full bg-indigo-600 text-white px-6 py-3 rounded-md hover:bg-indigo-700 flex items-center justify-center">
                        <i class="fas fa-shopping-cart mr-2"></i> Thêm Vào Giỏ Hàng
                    </button>
                </form>

                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <form asp-controller="Wishlist" asp-action="AddToWishlist" method="post">
                        <input type="hidden" name="productId" value="@product.product_id" />
                        <button type="submit" class="bg-white border border-indigo-600 text-indigo-600 px-4 py-3 rounded-md hover:bg-indigo-50">
                            <i class="fas fa-heart"></i>
                        </button>
                    </form>
                }
            </div>

            <div class="border-t pt-6">
                <div class="flex items-center text-sm text-gray-500 mb-2">
                    <span class="mr-2"><i class="fas fa-tag"></i></span>
                    <span>Mã SP: @product.sku</span>
                </div>
                <div class="flex items-center text-sm text-gray-500">
                    <span class="mr-2"><i class="fas fa-folder"></i></span>
                    <span>Danh mục: <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@product.category_id" class="text-indigo-600 hover:underline">@product.Category.name</a></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Product Description -->
    <div class="mb-16">
        <div class="border-b border-gray-200 mb-6">
            <ul class="flex flex-wrap -mb-px">
                <li class="mr-2">
                    <a href="#description" class="inline-block p-4 border-b-2 border-indigo-600 text-indigo-600 font-medium">Mô Tả</a>
                </li>
            </ul>
        </div>

        <div id="description" class="prose max-w-none">
            <p>@product.description</p>
        </div>
    </div>

    <!-- Related Products -->
    @if (relatedProducts.Count > 0)
    {
        <div>
            <h2 class="text-2xl font-bold mb-6">Sản Phẩm Liên Quan</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
                @foreach (var relatedProduct in relatedProducts)
                {
                    <div class="bg-white rounded-lg shadow-md overflow-hidden group">
                        <div class="relative overflow-hidden">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@relatedProduct.product_id">
                                <img src="~/Images/ProductImage/@relatedProduct.image" alt="@relatedProduct.name" class="w-full h-64 object-cover transform transition-transform group-hover:scale-105" />
                            </a>
                            <div class="absolute inset-0 bg-black bg-opacity-20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center space-x-2">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@relatedProduct.product_id" class="bg-white p-2 rounded-full hover:bg-indigo-600 hover:text-white">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (Context.Session.GetInt32("UserId") != null)
                                {
                                    <form asp-controller="Wishlist" asp-action="AddToWishlist" method="post">
                                        <input type="hidden" name="productId" value="@relatedProduct.product_id" />
                                        <button type="submit" class="bg-white p-2 rounded-full hover:bg-indigo-600 hover:text-white">
                                            <i class="fas fa-heart"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                        <div class="p-4">
                            <h3 class="font-medium text-gray-800 mb-2 truncate">@relatedProduct.name</h3>
                            <p class="text-indigo-600 font-bold">@relatedProduct.price.ToString("N0")</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Color selection
        const colorOptions = document.querySelectorAll('.color-option');
        const selectedColorIdInput = document.getElementById('selected-color-id');
        const formColorIdInput = document.getElementById('form-color-id');
        const mainImage = document.getElementById('main-image');

        colorOptions.forEach(option => {
            option.addEventListener('click', function () {
                // Remove active class from all options
                colorOptions.forEach(opt => opt.classList.remove('border-indigo-600'));

                // Add active class to selected option
                this.classList.add('border-indigo-600');

                // Update selected color ID
                const colorId = this.getAttribute('data-color-id');
                selectedColorIdInput.value = colorId;
                formColorIdInput.value = colorId;

                // Update main image if color has an image
                const imageUrl = this.getAttribute('data-image');
                if (imageUrl) {
                    mainImage.src = '/Images/ProductImage/' + imageUrl;
                }
            });
        });

        // Set initial active color
        if (colorOptions.length > 0) {
            colorOptions[0].classList.add('border-indigo-600');
        }

        // Quantity controls
        const quantityInput = document.getElementById('quantity');
        const formQuantityInput = document.getElementById('form-quantity');
        const decreaseBtn = document.getElementById('decrease-quantity');
        const increaseBtn = document.getElementById('increase-quantity');

        decreaseBtn.addEventListener('click', function () {
            let value = parseInt(quantityInput.value);
            if (value > 1) {
                value--;
                quantityInput.value = value;
                formQuantityInput.value = value;
            }
        });

        increaseBtn.addEventListener('click', function () {
            let value = parseInt(quantityInput.value);
            const max = parseInt(quantityInput.getAttribute('max'));
            if (value < max) {
                value++;
                quantityInput.value = value;
                formQuantityInput.value = value;
            }
        });

        quantityInput.addEventListener('change', function () {
            const max = parseInt(this.getAttribute('max'));
            let value = parseInt(this.value);

            if (isNaN(value) || value < 1) {
                value = 1;
            } else if (value > max) {
                value = max;
            }

            this.value = value;
            formQuantityInput.value = value;
        });

        // Gallery thumbnails
        const thumbnails = document.querySelectorAll('.thumbnail');
        thumbnails.forEach(thumbnail => {
            thumbnail.addEventListener('click', function () {
                mainImage.src = this.src;
            });
        });
    </script>
}