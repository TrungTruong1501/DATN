@{
    ViewData["Title"] = "Báo cáo tồn kho";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="min-h-screen bg-gray-100 p-6">
    <!-- Header Section -->
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Báo cáo tồn kho</h1>
        <div class="flex space-x-4">
            <a href="@Url.Action("Export", "Report", new { reportType = "inventory", startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })"
               class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
                <i class="fas fa-file-excel mr-2"></i>Xuất Excel
            </a>
            <a href="@Url.Action("GeneratePdf", "Report", new { reportType = "inventory", startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })"
               class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">
                <i class="fas fa-file-pdf mr-2"></i>Xuất PDF
            </a>
        </div>
    </div>

    <!-- Date Range Filter for Stock Movement -->
    <div class="bg-white rounded-lg shadow-md p-4 mb-6">
        <form method="get" action="@Url.Action("Inventory", "Report")" class="flex items-center space-x-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Từ ngày:</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Đến ngày:</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div class="mt-5">
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                    <i class="fas fa-filter mr-2"></i>Lọc
                </button>
            </div>
        </form>
    </div>

    <!-- Inventory Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Tổng sản phẩm</p>
                    <p class="text-2xl font-bold text-blue-600">@ViewBag.TotalProducts</p>
                </div>
                <div class="bg-blue-100 p-3 rounded-full">
                    <i class="fas fa-cubes text-blue-600 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Tổng tồn kho</p>
                    <p class="text-2xl font-bold text-green-600">@ViewBag.TotalStock</p>
                </div>
                <div class="bg-green-100 p-3 rounded-full">
                    <i class="fas fa-warehouse text-green-600 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Sản phẩm sắp hết</p>
                    <p class="text-2xl font-bold text-orange-600">@ViewBag.LowStockCount</p>
                </div>
                <div class="bg-orange-100 p-3 rounded-full">
                    <i class="fas fa-exclamation-triangle text-orange-600 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Sản phẩm hết hàng</p>
                    <p class="text-2xl font-bold text-red-600">@ViewBag.OutOfStockCount</p>
                </div>
                <div class="bg-red-100 p-3 rounded-full">
                    <i class="fas fa-times-circle text-red-600 text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Inventory by Category and Stock Movement -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <!-- Inventory by Category -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Tồn kho theo danh mục</h3>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Danh mục</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Số sản phẩm</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tồn kho</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Giá trị TB</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var category in ViewBag.InventoryByCategory)
                        {
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@category.CategoryName</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@category.ProductCount</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@category.TotalStock</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@category.AveragePrice.ToString("#,##0") ₫</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Stock Movement Chart
        <div class="bg-white rounded-lg shadow-md p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4">Xuất kho theo tháng</h3>
                    <canvas id="stockMovementChart"></canvas>
                </div>
                -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Phân bố tồn kho theo danh mục</h3>
            <div class="flex justify-center">
                <div style="max-width: 500px;">
                    <canvas id="inventoryDistributionChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Inventory Distribution Chart -->
   
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
   /**
     * // Stock Movement Chart
    const stockMovementData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.StockMovement));
    const stockMovementCtx = document.getElementById('stockMovementChart').getContext('2d');
    new Chart(stockMovementCtx, {
     type: 'bar',
     data: {
         labels: stockMovementData.map(item => item.Period),
         datasets: [{
             label: 'Số lượng xuất',
             data: stockMovementData.map(item => item.OutgoingStock),
             backgroundColor: 'rgba(236, 72, 153, 0.5)',
             borderColor: 'rgb(236, 72, 153)',
             borderWidth: 1,
             yAxisID: 'y'
         }, {
             label: 'Doanh thu',
             data: stockMovementData.map(item => item.Revenue),
             backgroundColor: 'rgba(59, 130, 246, 0.5)',
             borderColor: 'rgb(59, 130, 246)',
             borderWidth: 1,
             yAxisID: 'y1'
         }]
     },
     options: {
         responsive: true,
         scales: {
             y: {
                 type: 'linear',
                 display: true,
                 position: 'left',
                 ticks: {
                     callback: function (value) {
                         return value + ' sp';
                     }
                 }
             },
             y1: {
                 type: 'linear',
                 display: true,
                 position: 'right',
                 ticks: {
                     callback: function (value) {
                         return value.toLocaleString('vi-VN') + ' ₫';
                     }
                 },
                 grid: {
                     drawOnChartArea: false
                 }
             }
         },
         plugins: {
             tooltip: {
                 callbacks: {
                     label: function (context) {
                         if (context.datasetIndex === 0) {
                             return context.parsed.y + ' sản phẩm';
                         } else {
                             return context.parsed.y.toLocaleString('vi-VN') + ' ₫';
                         }
                     }
                 }
             }
         }
     }
    });
    */

    // Inventory Distribution Chart
    const inventoryDistributionData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.InventoryByCategory));
    const inventoryDistributionCtx = document.getElementById('inventoryDistributionChart').getContext('2d');
    new Chart(inventoryDistributionCtx, {
        type: 'pie',
        data: {
            labels: inventoryDistributionData.map(item => item.CategoryName),
            datasets: [{
                data: inventoryDistributionData.map(item => item.TotalStock),
                backgroundColor: [
                    'rgb(59, 130, 246)',
                    'rgb(16, 185, 129)',
                    'rgb(139, 92, 246)',
                    'rgb(236, 72, 153)',
                    'rgb(245, 158, 11)',
                    'rgb(14, 165, 233)',
                    'rgb(168, 85, 247)',
                    'rgb(251, 146, 60)'
                ]
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom',
                },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            const percentage = ((context.parsed / context.dataset.data.reduce((a, b) => a + b, 0)) * 100).toFixed(1);
                            return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                        }
                    }
                }
            }
        }
    });
</script>