@{
    ViewData["Title"] = "Báo cáo tổng quan";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="min-h-screen bg-gray-100 p-6">
    <!-- Header Section -->
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Báo cáo tổng quan</h1>
        <div class="flex space-x-4">
            <a href="@Url.Action("Sales", "Report")" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                <i class="fas fa-chart-line mr-2"></i>Báo cáo bán hàng
            </a>
            <a href="@Url.Action("Products", "Report")" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
                <i class="fas fa-box mr-2"></i>Báo cáo sản phẩm
            </a>
            <a href="@Url.Action("Customers", "Report")" class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 transition">
                <i class="fas fa-users mr-2"></i>Báo cáo khách hàng
            </a>
        </div>
    </div>

    <!-- Date Range Filter -->
    <div class="bg-white rounded-lg shadow-md p-4 mb-6">
        <form method="get" action="@Url.Action("Index", "Report")" class="flex items-center space-x-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Từ ngày:</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Đến ngày:</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div class="mt-5">
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                    <i class="fas fa-filter mr-2"></i>Lọc
                </button>
            </div>
        </form>
    </div>

    <!-- Summary Statistics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
        <!-- Total Sales Card -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Tổng doanh thu</p>
                    <p class="text-2xl font-bold text-green-600">@ViewBag.TotalSales.ToString("#,##0")</p>
                </div>
                <div class="bg-green-100 p-3 rounded-full">
                    VND
                </div>
            </div>
        </div>

        <!-- Total Orders Card -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Tổng đơn hàng</p>
                    <p class="text-2xl font-bold text-blue-600">@ViewBag.TotalOrders</p>
                </div>
                <div class="bg-blue-100 p-3 rounded-full">
                    <i class="fas fa-shopping-cart text-blue-600 text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Total Products Card -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Tổng sản phẩm</p>
                    <p class="text-2xl font-bold text-purple-600">@ViewBag.TotalProducts</p>
                </div>
                <div class="bg-purple-100 p-3 rounded-full">
                    <i class="fas fa-box text-purple-600 text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Total Customers Card -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Tổng khách hàng</p>
                    <p class="text-2xl font-bold text-indigo-600">@ViewBag.TotalCustomers</p>
                </div>
                <div class="bg-indigo-100 p-3 rounded-full">
                    <i class="fas fa-users text-indigo-600 text-xl"></i>
                </div>
            </div>
        </div>

        <!-- New Customers Card -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Khách hàng mới</p>
                    <p class="text-2xl font-bold text-orange-600">@ViewBag.NewCustomers</p>
                </div>
                <div class="bg-orange-100 p-3 rounded-full">
                    <i class="fas fa-user-plus text-orange-600 text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Recent Orders Chart -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Doanh thu theo ngày</h3>
            <div style="position: relative; height: 300px;">
                <canvas id="recentOrdersChart"></canvas>
            </div>
        </div>

        <!-- Category Stats Chart -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Doanh thu theo danh mục</h3>
            <div style="position: relative; height: 300px;">
                <canvas id="categoryStatsChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Top Products Table -->
    <div class="bg-white rounded-lg shadow-md p-6 mt-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Top sản phẩm bán chạy</h3>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sản phẩm</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Số lượng bán</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var product in ViewBag.TopProducts ?? new List<object>())
                    {
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@product.ProductName</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@product.QuantitySold</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Kiểm tra và khởi tạo biểu đồ doanh thu
        const recentOrdersData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.RecentOrders ?? new List<object>()));
        const recentOrdersCtx = document.getElementById('recentOrdersChart');

        if (recentOrdersCtx && recentOrdersData && recentOrdersData.length > 0) {
            new Chart(recentOrdersCtx, {
                type: 'line',
                data: {
                    labels: recentOrdersData.map(item => {
                        // Format ngày hiển thị
                        try {
                            const date = new Date(item.Date);
                            return date.toLocaleDateString('vi-VN', {
                                day: '2-digit',
                                month: '2-digit'
                            });
                        } catch (e) {
                            return item.Date;
                        }
                    }),
                    datasets: [{
                        label: 'Doanh thu (VND)',
                        data: recentOrdersData.map(item => item.Total),
                        borderColor: 'rgb(59, 130, 246)',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: 'rgb(59, 130, 246)',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            callbacks: {
                                label: function (context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    label += new Intl.NumberFormat('vi-VN', {
                                        style: 'currency',
                                        currency: 'VND'
                                    }).format(context.parsed.y);
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                maxRotation: 45,
                                minRotation: 45
                            }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) {
                                    return new Intl.NumberFormat('vi-VN', {
                                        style: 'currency',
                                        currency: 'VND',
                                        maximumFractionDigits: 0
                                    }).format(value);
                                }
                            },
                            grid: {
                                color: 'rgba(0, 0, 0, 0.1)'
                            }
                        }
                    },
                    animation: {
                        duration: 1000,
                        easing: 'easeInOutQuart'
                    }
                }
            });
        } else {
            console.warn('Không có dữ liệu biểu đồ doanh thu');
            if (recentOrdersCtx) {
                recentOrdersCtx.parentElement.innerHTML = '<p class="text-center text-gray-500 mt-10">Không có dữ liệu hiển thị</p>';
            }
        }

        // Kiểm tra và khởi tạo biểu đồ danh mục
        const categoryStatsData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.CategoryStats ?? new List<object>()));
        const categoryStatsCtx = document.getElementById('categoryStatsChart');

        if (categoryStatsCtx && categoryStatsData && categoryStatsData.length > 0) {
            new Chart(categoryStatsCtx, {
                type: 'doughnut',
                data: {
                    labels: categoryStatsData.map(item => item.CategoryName),
                    datasets: [{
                        data: categoryStatsData.map(item => item.Revenue),
                        backgroundColor: [
                            'rgb(59, 130, 246)',
                            'rgb(16, 185, 129)',
                            'rgb(139, 92, 246)',
                            'rgb(236, 72, 153)',
                            'rgb(245, 158, 11)',
                            'rgb(99, 102, 241)',
                            'rgb(244, 63, 94)',
                            'rgb(14, 165, 233)',
                            'rgb(34, 197, 94)',
                            'rgb(251, 191, 36)'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                generateLabels: function (chart) {
                                    const data = chart.data;
                                    if (data.labels.length && data.datasets.length) {
                                        return data.labels.map((label, i) => {
                                            const value = data.datasets[0].data[i];
                                            const total = data.datasets[0].data.reduce((a, b) => a + b, 0);
                                            const percentage = Math.round((value / total) * 100);
                                            return {
                                                text: `${label} (${percentage}%)`,
                                                fillStyle: data.datasets[0].backgroundColor[i],
                                                index: i
                                            };
                                        });
                                    }
                                    return [];
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    let label = context.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    label += new Intl.NumberFormat('vi-VN', {
                                        style: 'currency',
                                        currency: 'VND'
                                    }).format(context.parsed);

                                    // Tính phần trăm
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = ((context.parsed / total) * 100).toFixed(1);
                                    label += ` (${percentage}%)`;

                                    return label;
                                }
                            }
                        }
                    }
                }
            });
        } else {
            console.warn('Không có dữ liệu biểu đồ danh mục');
            if (categoryStatsCtx) {
                categoryStatsCtx.parentElement.innerHTML = '<p class="text-center text-gray-500 mt-10">Không có dữ liệu hiển thị</p>';
            }
        }
    });
</script>