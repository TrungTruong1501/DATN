@{
    ViewData["Title"] = "Báo cáo sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="min-h-screen bg-gray-100 p-6">
    <!-- Header Section -->
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Báo cáo sản phẩm</h1>
        <div class="flex space-x-4">
            <a href="@Url.Action("Export", "Report", new { reportType = "products", startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })"
               class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
                <i class="fas fa-file-excel mr-2"></i>Xuất Excel
            </a>
            <a href="@Url.Action("GeneratePdf", "Report", new { reportType = "products", startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })"
               class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">
                <i class="fas fa-file-pdf mr-2"></i>Xuất PDF
            </a>
        </div>
    </div>

    <!-- Date Range Filter -->
    <div class="bg-white rounded-lg shadow-md p-4 mb-6">
        <form method="get" action="@Url.Action("Products", "Report")" class="flex items-center space-x-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Từ ngày:</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Đến ngày:</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div class="mt-5">
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                    <i class="fas fa-filter mr-2"></i>Lọc
                </button>
            </div>
        </form>
    </div>

    <!-- Top Selling Products -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Top 10 sản phẩm bán chạy</h3>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Thứ hạng</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sản phẩm</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Số lượng bán</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Doanh thu</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @{
                        int rank = 1;
                    }
                    @foreach (var product in ViewBag.TopProducts)
                    {
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@rank</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@product.ProductName</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@product.QuantitySold</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@product.Revenue.ToString("#,##0") ₫</td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Sales by Category -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Doanh thu theo danh mục</h3>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div>
                <canvas id="categoryRevenueChart"></canvas>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Danh mục</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Số lượng</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var category in ViewBag.SalesByCategory)
                        {
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@category.CategoryName</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@category.QuantitySold</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@category.Revenue.ToString("#,##0") ₫</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Low Stock and Popular Colors -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <!-- Low Stock Products -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Sản phẩm sắp hết hàng (< 10)</h3>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sản phẩm</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tồn kho</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var product in ViewBag.LowStockProducts)
                        {
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@product.name</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@product.stock</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (product.stock == 0)
                                    {
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                            Hết hàng
                                        </span>
                                    }
                                    else if (product.stock < 5)
                                    {
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                            Rất ít
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                            Ít hàng
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Popular Colors -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Màu sắc được ưa chuộng</h3>
            <div class="space-y-4">
                @foreach (var color in ViewBag.PopularColors)
                {
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 rounded-full border-2 border-gray-300" style="background-color: @color.ColorHex;"></div>
                            <span class="text-sm font-medium text-gray-900">@color.ColorName</span>
                        </div>
                        <div class="text-sm text-gray-500">
                            @color.QuantitySold sản phẩm
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Category Revenue Chart
    const categoryRevenueData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.SalesByCategory));
    const categoryRevenueCtx = document.getElementById('categoryRevenueChart').getContext('2d');
    new Chart(categoryRevenueCtx, {
        type: 'pie',
        data: {
            labels: categoryRevenueData.map(item => item.CategoryName),
            datasets: [{
                data: categoryRevenueData.map(item => item.Revenue),
                backgroundColor: [
                    'rgb(59, 130, 246)',
                    'rgb(16, 185, 129)',
                    'rgb(139, 92, 246)',
                    'rgb(236, 72, 153)',
                    'rgb(245, 158, 11)',
                    'rgb(14, 165, 233)',
                    'rgb(168, 85, 247)',
                    'rgb(251, 146, 60)'
                ]
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'right',
                },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            return context.label + ': ' + context.parsed.toLocaleString('vi-VN') + ' ₫';
                        }
                    }
                }
            }
        }
    });
</script>