@{
    ViewData["Title"] = "Báo Cáo Doanh Số";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pb-5 border-b border-gray-200 mb-6">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Báo Cáo Doanh Số</h1>
            <p class="mt-2 text-sm text-gray-500">Theo dõi và phân tích hiệu suất bán hàng của bạn theo thời gian.</p>
        </div>
        <a href="@Url.Action("Export", "Report", new { reportType = "sales" })" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700">
            <i class="fas fa-file-csv mr-2"></i> Xuất Báo Cáo
        </a>
    </div>
</div>

<!-- Bộ Lọc Khoảng Thời Gian -->
<div class="bg-white overflow-hidden shadow-sm rounded-lg mb-8">
    <div class="px-6 py-5 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">Bộ Lọc Khoảng Thời Gian</h3>
    </div>
    <div class="p-6">
        <form method="get" action="@Url.Action("Sales", "Report")" class="flex flex-wrap items-end gap-4">
            <div>
                <label for="startDate" class="block text-sm font-medium text-gray-700">Ngày Bắt Đầu</label>
                <input type="date" id="startDate" name="startDate" value="@ViewBag.StartDate" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
            </div>
            <div>
                <label for="endDate" class="block text-sm font-medium text-gray-700">Ngày Kết Thúc</label>
                <input type="date" id="endDate" name="endDate" value="@ViewBag.EndDate" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
            </div>
            <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                Áp Dụng Bộ Lọc
            </button>
        </form>
    </div>
</div>

<!-- Thẻ Tóm Tắt -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
        <div class="p-5">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-indigo-500 rounded-md p-3">
                    <i class="fas fa-dollar-sign text-white text-xl"></i>
                </div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 truncate">Tổng Doanh Số</dt>
                        <dd class="text-3xl font-semibold text-gray-900">@ViewBag.TotalSales.ToString("N0")</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
        <div class="p-5">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-green-500 rounded-md p-3">
                    <i class="fas fa-shopping-cart text-white text-xl"></i>
                </div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 truncate">Số Lượng Đơn Hàng</dt>
                        <dd class="text-3xl font-semibold text-gray-900">@ViewBag.OrderCount</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white overflow-hidden shadow-sm rounded-lg">
        <div class="p-5">
            <div class="flex items-center">
                <div class="flex-shrink-0 bg-blue-500 rounded-md p-3">
                    <i class="fas fa-chart-line text-white text-xl"></i>
                </div>
                <div class="ml-5 w-0 flex-1">
                    <dl>
                        <dt class="text-sm font-medium text-gray-500 truncate">Giá Trị Đơn Hàng Trung Bình</dt>
                        <dd class="text-3xl font-semibold text-gray-900">@ViewBag.AverageOrderValue.ToString("N0")</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Biểu Đồ Doanh Số Theo Ngày -->
<div class="bg-white overflow-hidden shadow-sm rounded-lg mb-8">
    <div class="px-6 py-5 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">Xu Hướng Doanh Số</h3>
    </div>
    <div class="p-6">
        <div class="h-80">
            <canvas id="salesByDateChart"></canvas>
        </div>
    </div>
</div>

<!-- Doanh Số Theo Trạng Thái -->
<div class="bg-white overflow-hidden shadow-sm rounded-lg mb-8">
    <div class="px-6 py-5 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">Doanh Số Theo Trạng Thái Đơn Hàng</h3>
    </div>
    <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="h-64">
                <canvas id="salesByStatusChart"></canvas>
            </div>
            <div class="overflow-hidden">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Trạng Thái</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Đơn Hàng</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tổng Cộng</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var status in ViewBag.SalesByStatus)
                        {
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@status.Status</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@status.OrderCount</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@status.Total.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Biểu Đồ Doanh Số Theo Ngày
            const salesByDateData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.SalesByDate));
            const salesByDateCtx = document.getElementById('salesByDateChart').getContext('2d');

            const salesByDateChart = new Chart(salesByDateCtx, {
                type: 'line',
                data: {
                    labels: salesByDateData.map(item => item.Date),
                    datasets: [{
                        label: 'Doanh Số Hàng Ngày',
                        data: salesByDateData.map(item => item.Total),
                        backgroundColor: 'rgba(79, 70, 229, 0.2)',
                        borderColor: 'rgba(79, 70, 229, 1)',
                        borderWidth: 2,
                        tension: 0.4
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) {
                                    return value.toLocaleString();
                                }
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.raw.toLocaleString();
                                }
                            }
                        }
                    },
                    responsive: true,
                    maintainAspectRatio: false
                }
            });

            // Biểu Đồ Doanh Số Theo Trạng Thái
            const salesByStatusData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.SalesByStatus));
            const salesByStatusCtx = document.getElementById('salesByStatusChart').getContext('2d');

            const statusColors = {
                'Pending': 'rgba(251, 191, 36, 0.7)',
                'Processing': 'rgba(59, 130, 246, 0.7)',
                'Completed': 'rgba(16, 185, 129, 0.7)',
                'Unknown': 'rgba(156, 163, 175, 0.7)',
                'Đang Chờ': 'rgba(251, 191, 36, 0.7)',
                'Đang Xử Lý': 'rgba(59, 130, 246, 0.7)',
                'Hoàn Thành': 'rgba(16, 185, 129, 0.7)',
                'Không Xác Định': 'rgba(156, 163, 175, 0.7)'
            };

            const statusBorderColors = {
                'Pending': 'rgb(251, 191, 36)',
                'Processing': 'rgb(59, 130, 246)',
                'Completed': 'rgb(16, 185, 129)',
                'Unknown': 'rgb(156, 163, 175)',
                'Đang Chờ': 'rgb(251, 191, 36)',
                'Đang Xử Lý': 'rgb(59, 130, 246)',
                'Hoàn Thành': 'rgb(16, 185, 129)',
                'Không Xác Định': 'rgb(156, 163, 175)'
            };

            const salesByStatusChart = new Chart(salesByStatusCtx, {
                type: 'doughnut',
                data: {
                    labels: salesByStatusData.map(item => item.Status),
                    datasets: [{
                        data: salesByStatusData.map(item => item.Total),
                        backgroundColor: salesByStatusData.map(item => statusColors[item.Status]),
                        borderColor: salesByStatusData.map(item => statusBorderColors[item.Status]),
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return context.label + ': ' + context.raw.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}