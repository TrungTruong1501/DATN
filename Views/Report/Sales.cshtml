@{
    ViewData["Title"] = "Báo cáo bán hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="min-h-screen bg-gray-100 p-6">
    <!-- Header Section -->
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Báo cáo bán hàng</h1>
        <div class="flex space-x-4">
            <a href="@Url.Action("Export", "Report", new { reportType = "sales", startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })"
               class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
                <i class="fas fa-file-excel mr-2"></i>Xuất Excel
            </a>
            <a href="@Url.Action("GeneratePdf", "Report", new { reportType = "sales", startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })"
               class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">
                <i class="fas fa-file-pdf mr-2"></i>Xuất PDF
            </a>
        </div>
    </div>

    <!-- Date Range Filter -->
    <div class="bg-white rounded-lg shadow-md p-4 mb-6">
        <form method="get" action="@Url.Action("Sales", "Report")" class="flex items-center space-x-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Từ ngày:</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Đến ngày:</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div class="mt-5">
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                    <i class="fas fa-filter mr-2"></i>Lọc
                </button>
            </div>
        </form>
    </div>

    <!-- Summary Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Tổng doanh thu</p>
                    <p class="text-2xl font-bold text-green-600">@ViewBag.TotalSales.ToString("#,##0") ₫</p>
                </div>
                <div class="bg-green-100 p-3 rounded-full">
                    VND
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Số đơn hàng</p>
                    <p class="text-2xl font-bold text-blue-600">@ViewBag.OrderCount</p>
                </div>
                <div class="bg-blue-100 p-3 rounded-full">
                    <i class="fas fa-shopping-cart text-blue-600 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Giá trị đơn hàng trung bình</p>
                    <p class="text-2xl font-bold text-purple-600">@ViewBag.AverageOrderValue.ToString("#,##0") ₫</p>
                </div>
                <div class="bg-purple-100 p-3 rounded-full">
                    <i class="fas fa-chart-bar text-purple-600 text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <!-- Sales by Date -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Doanh thu theo ngày</h3>
            <canvas id="salesByDateChart"></canvas>
        </div>

        <!-- Sales by Month -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Doanh thu theo tháng</h3>
            <canvas id="salesByMonthChart"></canvas>
        </div>
    </div>

    <!-- Sales Tables -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Sales by Status -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Doanh thu theo trạng thái</h3>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Trạng thái</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Số đơn</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var item in ViewBag.SalesByStatus)
                        {
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.Status</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.OrderCount</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.Total.ToString("#,##0") ₫</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Sales by Payment Method -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Doanh thu theo phương thức thanh toán</h3>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Phương thức</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Số đơn</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var item in ViewBag.SalesByPayment)
                        {
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.PaymentMethod</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.OrderCount</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.Total.ToString("#,##0") ₫</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Sales by Date Chart
    const salesByDateData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.SalesByDate));
    const salesByDateCtx = document.getElementById('salesByDateChart').getContext('2d');
    new Chart(salesByDateCtx, {
        type: 'bar',
        data: {
            labels: salesByDateData.map(item => item.Date),
            datasets: [{
                label: 'Doanh thu (VND)',
                data: salesByDateData.map(item => item.Total),
                backgroundColor: 'rgba(59, 130, 246, 0.5)',
                borderColor: 'rgb(59, 130, 246)',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function (value) {
                            return value.toLocaleString('vi-VN') + ' ₫';
                        }
                    }
                }
            },
            plugins: {
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            return context.parsed.y.toLocaleString('vi-VN') + ' ₫';
                        }
                    }
                }
            }
        }
    });

    // Sales by Month Chart
    const salesByMonthData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.SalesByMonth));
    const salesByMonthCtx = document.getElementById('salesByMonthChart').getContext('2d');
    new Chart(salesByMonthCtx, {
        type: 'line',
        data: {
            labels: salesByMonthData.map(item => item.Period),
            datasets: [{
                label: 'Doanh thu (VND)',
                data: salesByMonthData.map(item => item.Total),
                borderColor: 'rgb(16, 185, 129)',
                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function (value) {
                            return value.toLocaleString('vi-VN') + ' ₫';
                        }
                    }
                }
            },
            plugins: {
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            return context.parsed.y.toLocaleString('vi-VN') + ' ₫';
                        }
                    }
                }
            }
        }
    });
</script>