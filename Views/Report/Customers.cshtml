@{
    ViewData["Title"] = "Báo cáo khách hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="min-h-screen bg-gray-100 p-6">
    <!-- Header Section -->
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Báo cáo khách hàng</h1>
        <div class="flex space-x-4">
            <a href="@Url.Action("Export", "Report", new { reportType = "customers", startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })"
               class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition">
                <i class="fas fa-file-excel mr-2"></i>Xuất Excel
            </a>
            <a href="@Url.Action("GeneratePdf", "Report", new { reportType = "customers", startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })"
               class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition">
                <i class="fas fa-file-pdf mr-2"></i>Xuất PDF
            </a>
        </div>
    </div>

    <!-- Date Range Filter -->
    <div class="bg-white rounded-lg shadow-md p-4 mb-6">
        <form method="get" action="@Url.Action("Customers", "Report")" class="flex items-center space-x-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Từ ngày:</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Đến ngày:</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="border border-gray-300 rounded px-3 py-2 text-sm">
            </div>
            <div class="mt-5">
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                    <i class="fas fa-filter mr-2"></i>Lọc
                </button>
            </div>
        </form>
    </div>

    <!-- Customer Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Tỷ lệ khách hàng quay lại</p>
                    <p class="text-2xl font-bold text-blue-600">@ViewBag.RetentionRate%</p>
                </div>
                <div class="bg-blue-100 p-3 rounded-full">
                    <i class="fas fa-sync-alt text-blue-600 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Khách hàng quay lại</p>
                    <p class="text-2xl font-bold text-green-600">@ViewBag.RepeatCustomers</p>
                </div>
                <div class="bg-green-100 p-3 rounded-full">
                    <i class="fas fa-user-friends text-green-600 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Khách hàng mua 1 lần</p>
                    <p class="text-2xl font-bold text-orange-600">@ViewBag.OneTimeCustomers</p>
                </div>
                <div class="bg-orange-100 p-3 rounded-full">
                    <i class="fas fa-user text-orange-600 text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Customers -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Top 10 khách hàng</h3>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Thứ hạng</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Khách hàng</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Số đơn hàng</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tổng chi tiêu</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Giá trị trung bình/đơn</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @{
                        int rank = 1;
                    }
                    @foreach (var customer in ViewBag.TopCustomers)
                    {
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@rank</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@customer.UserName</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@customer.OrderCount</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@customer.TotalSpent.ToString("#,##0") ₫</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@((customer.TotalSpent / customer.OrderCount).ToString("#,##0")) ₫</td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- New Customers and Customer Source -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- New Customers by Month -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Khách hàng mới theo tháng</h3>
            <canvas id="newCustomersChart"></canvas>
        </div>

        <!-- Customer Acquisition Sources -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Nguồn khách hàng</h3>
            <canvas id="customerSourceChart"></canvas>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // New Customers Chart
    const newCustomersData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.NewCustomersByMonth));
    const newCustomersCtx = document.getElementById('newCustomersChart').getContext('2d');
    new Chart(newCustomersCtx, {
        type: 'bar',
        data: {
            labels: newCustomersData.map(item => item.Month),
            datasets: [{
                label: 'Khách hàng mới',
                data: newCustomersData.map(item => item.Count),
                backgroundColor: 'rgba(59, 130, 246, 0.5)',
                borderColor: 'rgb(59, 130, 246)',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1
                    }
                }
            }
        }
    });

    // Customer Source Chart
    const customerSourceData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.CustomerSource));
    const customerSourceCtx = document.getElementById('customerSourceChart').getContext('2d');
    new Chart(customerSourceCtx, {
        type: 'doughnut',
        data: {
            labels: customerSourceData.map(item => item.Source),
            datasets: [{
                data: customerSourceData.map(item => item.Count),
                backgroundColor: [
                    'rgb(59, 130, 246)',
                    'rgb(16, 185, 129)',
                    'rgb(139, 92, 246)',
                    'rgb(236, 72, 153)',
                    'rgb(245, 158, 11)'
                ]
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom',
                },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            const percentage = ((context.parsed / customerSourceData.reduce((sum, item) => sum + item.Count, 0)) * 100).toFixed(1);
                            return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                        }
                    }
                }
            }
        }
    });
</script>